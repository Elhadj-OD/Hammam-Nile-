# SUPABASE BACKEND CONFIGURATION
# Obtenez ces deux valeurs dans votre tableau de bord Supabase : Project Settings > API
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-key-here"

# Clé service_role Supabase — utilisée UNIQUEMENT côté serveur
# (api/admin-users.ts, scripts/migrate-users-to-auth.mjs) pour créer/gérer
# les comptes staff. Ne PAS préfixer par VITE_ : cette clé contourne toute
# sécurité (RLS) et ne doit JAMAIS être exposée au navigateur.
# Project Settings > API > service_role (secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key-here"

# ASSISTANT IA (Gemini) — utilisé UNIQUEMENT côté serveur (api/gemini-chat.ts).
# Ne PAS préfixer par VITE_ : cette clé ne doit jamais être exposée au navigateur.
# Obtenez une clé sur https://aistudio.google.com/apikey
GEMINI_API_KEY="your-gemini-api-key-here"
