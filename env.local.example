# ============================================================
#  Café Dugout — variables d'environnement
#  Copier en .env.local (ne JAMAIS committer ce fichier)
# ============================================================

# --- Supabase (public : visible dans le navigateur, c'est normal) -----
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=COLLEZ-ICI-VOTRE-CLE-ANON

# --- Supabase (SERVEUR UNIQUEMENT) ------------------------------------
# Indispensable pour les webhooks de paiement (écriture dans webhook_events).
# ⚠️ Ne JAMAIS préfixer par NEXT_PUBLIC_ : la clé partirait dans le navigateur.
# Sur Vercel : Settings -> Environment Variables (cocher "Server" uniquement).
SUPABASE_SERVICE_ROLE_KEY=

# --- Jetons de table signés (QR de session) ---------------------------
# 32+ caractères aléatoires : openssl rand -base64 48
# Sert à signer/décoder les QR de session (durée 15 min par défaut).
TABLE_TOKEN_SECRET=

# --- Webhooks de paiement (SERVEUR UNIQUEMENT) ------------------------
# Chaque opérateur fournit sa clé secrète dans son contrat marchand.
# Une clé par opérateur : une fuite chez l'un ne compromet pas les autres.
PAYMENT_SECRET_BANKILY=
PAYMENT_SECRET_MASRIVI=
PAYMENT_SECRET_SEDAD=
PAYMENT_SECRET_CLICK=

# --- Limitation de débit (production multi-instances) -----------------
# Recommandé sur Vercel : sans Redis, chaque instance compte séparément.
# Compte gratuit sur https://upstash.com -> REST URL + token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Divers -----------------------------------------------------------
# URL publique du site (liens dans les QR) — sinon déduite de la requête
NEXT_PUBLIC_SITE_URL=https://cafe-dugout.vercel.app
