rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    // Clients Collection
    match /clients/{clientId} {
      allow read: if true;
      allow create, update: if isValidId(clientId)
        && incoming().name is string
        && incoming().name.size() > 0
        && incoming().name.size() <= 100;
      allow delete: if true;
    }

    // Sales Collection
    match /sales/{saleId} {
      allow read: if true;
      allow create: if isValidId(saleId)
        && incoming().total is number
        && incoming().caissier is string;
      allow update: if isValidId(saleId);
      allow delete: if true;
    }

    // Security Verifications (2FA Email Code for Admin)
    match /security_verifications/{verificationId} {
      allow read: if isValidId(verificationId);
      allow create: if isValidId(verificationId)
        && incoming().email is string
        && incoming().code is string
        && incoming().expiresAt is number;
      allow update: if isValidId(verificationId);
      allow delete: if isValidId(verificationId);
    }

    // General Settings
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isValidId(settingId);
    }
  }
}
